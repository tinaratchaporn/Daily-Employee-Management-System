# เริ่มมาก็สร้าง โฟร์เดอร์ 
# ติดตั้ง npm init -y, npm i express, npm i --save-dev typescript ts-node nodemon @types/node @types/express
# สร้างไฟล์ config ของ ts. npx tsc --init
# แก้ไขไฟล์ tsconfig {
#   "compilerOptions": {
#     "target": "ES6",
#     "module": "CommonJS",
#     "rootDir": "./src",
#     "outDir": "./dist",
#     "esModuleInterop": true,
#     "strict": true,
#     "skipLibCheck": true
#   }
# }
# สร้าง src และ ไฟล์
